<?xml version="1.0" encoding="utf-8"?>
<!-- Tema base de la actividad (se ve un instante antes de que cargue Compose). -->
<resources>
    <style name="Theme.GamoPanel" parent="android:Theme.Material.NoActionBar">
        <!-- Fondo negro: evita el destello blanco al abrir. -->
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Permite dibujar en la zona del recorte (perforación de cámara del Honor 90). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Barras transparentes sin "scrim" gris forzado. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
